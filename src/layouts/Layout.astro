---
import "../styles/global.css";
import AuthNav from "../components/AuthNav";
import ThemeApplier from "../components/ThemeApplier";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "School Events Hub",
  description = "Every school event. One place.",
} = Astro.props;

const links = [
  { href: "/", label: "Home" },
  { href: "/events", label: "Calendar" },
  { href: "/announcements", label: "Announcements" },
  { href: "/tickets", label: "Tickets" },
  { href: "/dashboard", label: "Dashboard" },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <ThemeApplier client:load />
    <header class="sticky top-0 z-50 border-b border-white/10 bg-[#0d0f18]/85 backdrop-blur">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href="/" class="flex items-center gap-2 font-bold tracking-tight">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-indigo-500 to-violet-500 text-sm font-black text-white">
            SEH
          </span>
          <span class="text-slate-100">School Events Hub</span>
        </a>
        <div class="flex items-center gap-1 text-sm font-medium text-slate-300">
          {
            links.map((link) => (
              <a href={link.href} class="rounded-lg px-3 py-1.5 transition-colors hover:bg-white/5 hover:text-white">
                {link.label}
              </a>
            ))
          }
          <AuthNav client:load />
        </div>
      </nav>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-white/10 py-8 text-center text-sm text-slate-500">
      School Events Hub · a digital command center for school events
    </footer>
  </body>
</html>