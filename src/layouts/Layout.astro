---
import "../styles/global.css";
import AuthNav from "../components/AuthNav";
import ThemeApplier from "../components/ThemeApplier";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "School Events Hub",
  description = "Every school event. One place.",
} = Astro.props;

const links = [
  { href: "/", label: "Home" },
  { href: "/events", label: "Calendar" },
  { href: "/announcements", label: "Announcements" },
  { href: "/tickets", label: "Tickets" },
  { href: "/dashboard", label: "Dashboard" },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <ThemeApplier client:load />
    <div class="lg:grid lg:grid-cols-[15rem_1fr]">
      <aside class="hidden lg:flex lg:h-dvh lg:flex-col lg:gap-6 lg:border-r lg:border-white/10 lg:bg-[#0d0f18] lg:px-4 lg:py-5 lg:sticky lg:top-0">
        <a href="/" class="flex shrink-0 items-center gap-2 font-bold tracking-tight">
          <span class="grid h-9 w-9 place-items-center rounded-lg bg-gradient-to-br from-indigo-500 to-violet-500 text-sm font-black text-white">
            SEH
          </span>
          <span class="text-slate-100">School Events Hub</span>
        </a>
        <nav class="flex flex-col gap-1 text-sm font-medium text-slate-300">
          {
            links.map((link) => (
              <a href={link.href} class="whitespace-nowrap rounded-lg px-3 py-2 transition-colors hover:bg-white/5 hover:text-white">
                {link.label}
              </a>
            ))
          }
        </nav>
      </aside>

      <div class="flex min-w-0 flex-col">
        <header class="sticky top-0 z-50 border-b border-white/10 bg-[#0d0f18]/85 backdrop-blur lg:hidden">
          <nav class="flex items-center gap-3 px-4 py-3">
            <a href="/" class="flex shrink-0 items-center gap-2 font-bold tracking-tight">
              <span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-indigo-500 to-violet-500 text-sm font-black text-white">
                SEH
              </span>
              <span class="hidden text-slate-100 sm:inline">School Events Hub</span>
            </a>
            <div class="-mx-1 flex min-w-0 flex-1 items-center gap-0.5 overflow-x-auto text-sm font-medium text-slate-300">
              {
                links.map((link) => (
                  <a href={link.href} class="whitespace-nowrap rounded-lg px-2.5 py-1.5 transition-colors hover:bg-white/5 hover:text-white">
                    {link.label}
                  </a>
                ))
              }
            </div>
            <div class="flex shrink-0 items-center">
              <AuthNav client:load />
            </div>
          </nav>
        </header>

        <div class="hidden justify-end px-8 pt-4 lg:flex">
          <AuthNav client:load />
        </div>

        <main class="flex-1 px-4 py-8 lg:px-8">
          <slot />
        </main>

        <footer class="border-t border-white/10 py-8 text-center text-sm text-slate-500">
          School Events Hub · a digital command center for school events
        </footer>
      </div>
    </div>
  </body>
</html>